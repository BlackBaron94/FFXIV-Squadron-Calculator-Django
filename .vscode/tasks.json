{
    "version": "2.0.0",
    "tasks" : [
        {
            "label": "Start Dev Server",
            "dependsOn": [
                "Django Server",
                "WSL",
                "Celery"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Django Server",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\activate; python manage.py runserver",
            "presentation": {"group": "fullstack1", "panel": "dedicated"}
        },
        {
            "label": "WSL",
            "type": "shell",
            "command": "wsl",
            "presentation": {"group": "fullstack1", "panel": "dedicated"}
        },
        {
            "label": "Celery",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\activate; celery -A project worker --concurrency=8 --pool=threads --loglevel=info",
            "presentation": {"group": "fullstack1", "panel": "dedicated"}
        },
        {
            "label": "Make New Migrations",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\activate; python manage.py makemigrations;"
        },
        {
            "label": "Migrate",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\activate; python manage.py migrate;"
        },
        {
            "label": "Make Migrations & Migrate",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\activate; python manage.py makemigrations; python manage.py migrate;"
        }
    ]
}